# Local starter environment for development. Copy this file to .env and keep .env untracked.
# Loaded by python-dotenv from the project root (manage.py and config/settings.py).

# --- Django ---
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Optional third-party API keys (leave empty unless you have your own) ---
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1
AIRLABS_API_KEY=
AIRLABS_BASE_URL=https://airlabs.co/api/v9
DEEPL_API_KEY=
OPENWEATHERMAP_API_KEY=
OPENAI_API_KEY=

# --- OpenSky (public bbox defaults from settings.py; credentials optional) ---
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_TIMEOUT=20
OPENSKY_LAMIN=35.0
OPENSKY_LAMAX=60.0
OPENSKY_LOMIN=-10.0
OPENSKY_LOMAX=40.0

# --- Operational Copilot: local GPT4All model disabled ---
COPILOT_GPT4ALL_ENABLED=False
COPILOT_GPT4ALL_MODEL_NAME=
COPILOT_GPT4ALL_MODEL_PATH=
COPILOT_GPT4ALL_DEVICE=cpu
COPILOT_GPT4ALL_THREADS=8
COPILOT_GPT4ALL_CTX=2048
COPILOT_GPT4ALL_MAX_TOKENS=120
COPILOT_GPT4ALL_TEMP=0.1

# --- Operational Copilot: paid OpenAI / external LLM disabled ---
COPILOT_EXTERNAL_LLM_ENABLED=False
COPILOT_LLM_PROVIDER=openai
COPILOT_LLM_MODEL=gpt-4.1-mini
COPILOT_LLM_TEMPERATURE=0.2
COPILOT_LLM_MAX_OUTPUT_TOKENS=700
COPILOT_LLM_TIMEOUT_SECONDS=30

# --- Operational Copilot: local Ollama disabled ---
COPILOT_LOCAL_LLM_ENABLED=False
COPILOT_LOCAL_LLM_PROVIDER=ollama
COPILOT_OLLAMA_BASE_URL=http://localhost:11434
COPILOT_OLLAMA_MODEL=llama3.2:3b
COPILOT_OLLAMA_TEMPERATURE=0.2
COPILOT_OLLAMA_TIMEOUT_SECONDS=60
COPILOT_LOCAL_REWRITE_ENABLED=False
COPILOT_LOCAL_REWRITE_MAX_LENGTH=900

# --- Operational Copilot: safety ---
COPILOT_ALLOW_EXTERNAL_GENERAL_CHAT=False
COPILOT_STRICT_DATABASE_GROUNDING=True
COPILOT_DEFAULT_LANGUAGE=en
